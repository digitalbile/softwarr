{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    "customManagers:githubActionsVersions"
  ],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Merge digest pins and digest, patch, and minor updates once CI passes",
      "matchUpdateTypes": ["pinDigest", "digest", "patch", "minor"],
      "automerge": true
    }
  ]
}
